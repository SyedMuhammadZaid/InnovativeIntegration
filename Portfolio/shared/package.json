        "dev:db": "nodemon --watch src --exec tsx src/db.ts"
    },
    "dependencies": {
        "@prisma/client": "^6.16.1"
    },
    "devDependencies": {
        "@types/node": "^24.4.0",
        "prisma": "latest",
        "ts-node": "^10.9.2",
        "tsx": "^4.20.5",
        "typescript": "^5.9.2"
    }
}