{
    "name": "@innovative-integration/shared",
    "version": "0.1.0",
    "private": true,
    "description": "Shared logic and dependencies for the Innovative Integration monorepo.",
    "main": "index.ts",
    "scripts": {
        "db:migrate": "prisma migrate dev",
