{
    "name": "@innovative-integration/shared",
    "version": "0.1.0",
    "private": true,
    "description": "Shared logic and dependencies for the Innovative Integration monorepo.",
    "main": "index.ts",
    "type": "module",
    "scripts": {
        "db:migrate": "npx prisma migrate dev",
        "db:generate": "npx prisma generate",
        "db:push": "npx prisma db push",
        "db:studio": "npx prisma studio",
        "start:db": "tsx src/db.ts",
        "dev:db": "nodemon --watch src --exec tsx src/db.ts",
        "create:admin": "tsx src/scripts/createAdmin.ts"
    },
    "dependencies": {
        "@prisma/client": "^6.19.1",
        "bcryptjs": "^3.0.3",
        "jsonwebtoken": "^9.0.2",
        "server-only": "^0.0.1"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.4.0",
        "prisma": "6.19.1",
        "ts-node": "^10.9.2",
        "tsx": "^4.20.5",
        "typescript": "^5.9.2"
    },
    "browser": false
}
